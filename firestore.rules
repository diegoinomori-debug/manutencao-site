rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return hasProfile() && profile().get("active", false) == true;
    }

    function role() {
      return hasProfile() ? profile().get("role", "operator") : "none";
    }

    function isAdmin() {
      return activeUser() && (
        role() == "admin" ||
        profile().get("isAdmin", false) == true
      );
    }

    function canInspect() {
      return activeUser() && (
        role() == "inspector" ||
        role() == "approver" ||
        role() == "admin" ||
        profile().get("canInspect", false) == true
      );
    }

    function canApprove() {
      return activeUser() && (
        role() == "approver" ||
        role() == "admin" ||
        profile().get("canApprove", false) == true
      );
    }

    match /users/{userId} {
      allow read: if activeUser()
        && (request.auth.uid == userId || isAdmin());

      allow create, update, delete: if isAdmin();
    }

    match /maintenanceReports/{reportId} {
      allow read: if activeUser();

      allow create: if activeUser()
        && request.resource.data.get("approvalStatus", "下書き")
          in ["下書き", "点検待ち", "Excel取込"]
        && request.resource.data.get("inspectedBy", "") == ""
        && request.resource.data.get("approvedBy", "") == "";

      allow update: if activeUser()
        && inspectionChangeAllowed()
        && approvalChangeAllowed()
        && creatorChangeAllowed()
        && statusChangeAllowed();

      allow delete: if isAdmin();

      function inspectionChangeAllowed() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny([
          "inspectedBy",
          "inspectedDate",
          "inspectedByUid",
          "inspectedByEmail",
          "inspectedAt"
        ]) || canInspect();
      }

      function approvalChangeAllowed() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny([
          "approvedBy",
          "approvedDate",
          "approvedByUid",
          "approvedByEmail",
          "approvedAt"
        ]) || canApprove();
      }

      function creatorChangeAllowed() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny([
          "createdBy",
          "createdByUid",
          "createdByEmail",
          "createdAtAudit",
          "reportCreatedDate"
        ]) || isAdmin();
      }

      function statusChangeAllowed() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let oldStatus = resource.data.get("approvalStatus", "下書き");
        let newStatus = request.resource.data.get("approvalStatus", "下書き");

        return !changed.hasAny(["approvalStatus"])
          || (
            oldStatus == "承認済み"
              ? canApprove()
              : newStatus == "承認済み"
                ? canApprove()
                : newStatus == "承認待ち"
                  ? canInspect()
                  : newStatus == "差戻し"
                    ? canInspect()
                    : true
          );
      }
    }

    match /{collectionName}/{document=**} {
      allow read, write: if activeUser()
        && collectionName != "users"
        && collectionName != "maintenanceReports";
    }
  }
}
