rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function activeUser() { return hasProfile() && profile().get('active', false) == true; }
    function role() { return profile().get('role', 'operator'); }
    function canWrite() {
      return activeUser() && role() in ['operator', 'inspector', 'approver', 'admin']
        && profile().get('readOnly', false) != true;
    }
    function isAdmin() {
      return canWrite() && (role() == 'admin' || profile().get('isAdmin', false) == true);
    }
    function canInspect() {
      return canWrite() && (role() in ['inspector', 'approver', 'admin']
        || profile().get('canInspect', false) == true);
    }
    function canApprove() {
      return canWrite() && (role() in ['approver', 'admin']
        || profile().get('canApprove', false) == true);
    }
    match /users/{userId} {
      // Users must be able to read their own inactive profile at login.
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }
    match /maintenanceReports/{reportId} {
      allow read: if activeUser();
      allow create: if canWrite()
        && request.resource.data.get('createdByUid', request.auth.uid) == request.auth.uid
        && request.resource.data.get('approvalStatus', '下書き') in ['下書き', '点検待ち', 'Excel取込']
        && emptyInspection(request.resource.data)
        && emptyApproval(request.resource.data);
      allow update: if canWrite() && approvedLock()
        && inspectionChangeAllowed() && approvalChangeAllowed()
        && creatorChangeAllowed() && statusChangeAllowed();
      allow delete: if isAdmin();

      function emptyInspection(data) {
        return data.get('inspectedBy', '') == '' && data.get('inspectedByUid', '') == ''
          && data.get('inspectedByEmail', '') == '' && data.get('inspectedDate', '') == ''
          && data.get('inspectedAt', '') == '';
      }
      function emptyApproval(data) {
        return data.get('approvedBy', '') == '' && data.get('approvedByUid', '') == ''
          && data.get('approvedByEmail', '') == '' && data.get('approvedDate', '') == ''
          && data.get('approvedAt', '') == '';
      }
      function approvedLock() {
        return resource.data.get('approvalStatus', '下書き') != '承認済み'
          || (canApprove() && request.resource.data.approvalStatus == '差戻し'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['approvalStatus', 'returnedBy', 'returnedByUid', 'returnedAt'])
            && request.resource.data.get('returnedByUid', '') == request.auth.uid);
      }
      function inspectionChangeAllowed() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny(['inspectedBy', 'inspectedDate', 'inspectedByUid', 'inspectedByEmail', 'inspectedAt'])
          || (canInspect() && (emptyInspection(request.resource.data)
            || request.resource.data.get('inspectedByUid', '') == request.auth.uid))
          || (request.resource.data.approvalStatus == '点検待ち'
            && resource.data.get('approvalStatus', '下書き') in ['下書き', '差戻し', 'Excel取込']
            && emptyInspection(request.resource.data) && emptyApproval(request.resource.data));
      }
      function approvalChangeAllowed() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return !changed.hasAny(['approvedBy', 'approvedDate', 'approvedByUid', 'approvedByEmail', 'approvedAt'])
          || (canApprove() && (emptyApproval(request.resource.data)
            || request.resource.data.get('approvedByUid', '') == request.auth.uid))
          || (request.resource.data.approvalStatus == '点検待ち'
            && resource.data.get('approvalStatus', '下書き') in ['下書き', '差戻し', 'Excel取込']
            && emptyInspection(request.resource.data) && emptyApproval(request.resource.data));
      }
      function creatorChangeAllowed() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'createdBy', 'createdByUid', 'createdByEmail', 'createdAtAudit', 'reportCreatedDate'
        ]) || isAdmin();
      }
      function statusChangeAllowed() {
        let oldStatus = resource.data.get('approvalStatus', '下書き');
        let newStatus = request.resource.data.get('approvalStatus', '下書き');
        return oldStatus == newStatus
          || (newStatus == '承認済み' && canApprove() && oldStatus == '承認待ち'
            && request.resource.data.get('inspectedBy', '') != ''
            && request.resource.data.get('approvedByUid', '') == request.auth.uid)
          || (newStatus == '承認待ち' && canInspect() && oldStatus == '点検待ち'
            && request.resource.data.get('inspectedByUid', '') == request.auth.uid)
          || (newStatus == '差戻し' && (oldStatus == '承認済み' ? canApprove() : canInspect()))
          || (newStatus in ['下書き', '点検待ち']
            && oldStatus in ['下書き', '点検待ち', '差戻し', 'Excel取込']);
      }
    }
    match /{collectionName}/{documentId} {
      allow read: if activeUser() && collectionName in [
        'parts', 'calendar', 'plannedWorks', 'dailyProductions', 'productionLogs', 'newEquipmentProjects'
      ];
      allow create, update: if canWrite() && collectionName in [
        'parts', 'calendar', 'plannedWorks', 'dailyProductions', 'productionLogs', 'newEquipmentProjects'
      ];
      allow delete: if isAdmin() && collectionName in [
        'parts', 'calendar', 'plannedWorks', 'dailyProductions', 'productionLogs', 'newEquipmentProjects'
      ];
    }
  }
}
