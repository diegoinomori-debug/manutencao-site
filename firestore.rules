rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return hasProfile() && profile().get('active', false) == true;
    }

    function role() {
      return profile().get('role', 'operator');
    }

    function canWrite() {
      return activeUser()
        && role() in ['operator', 'inspector', 'approver', 'admin']
        && profile().get('readOnly', false) != true;
    }

    function isAdmin() {
      return canWrite()
        && (role() == 'admin' || profile().get('isAdmin', false) == true);
    }

    function canInspect() {
      return canWrite()
        && (
          role() in ['inspector', 'approver', 'admin']
          || profile().get('canInspect', false) == true
        );
    }

    function canApprove() {
      return canWrite()
        && (
          role() in ['approver', 'admin']
          || profile().get('canApprove', false) == true
        );
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create, update, delete: if isAdmin();
    }

    match /maintenanceReports/{reportId} {
      allow read: if activeUser();

      allow create: if canWrite()
        && request.resource.data.get('createdByUid', request.auth.uid)
          == request.auth.uid
        && request.resource.data.get('approvalStatus', '下書き')
          in ['下書き', '点検待ち', 'Excel取込']
        && emptyInspection(request.resource.data)
        && emptyApproval(request.resource.data);

      allow update: if canWrite()
        && approvedLock()
        && inspectionChangeAllowed()
        && approvalChangeAllowed()
        && creatorChangeAllowed()
        && statusChangeAllowed();

      allow delete: if isAdmin();

      function emptyInspection(data) {
        return data.get('inspectedBy', '') == ''
          && data.get('inspectedByUid', '') == ''
          && data.get('inspectedByEmail', '') == ''
          && data.get('inspectedDate', '') == ''
          && data.get('inspectedAt', '') == '';
      }

      function emptyApproval(data) {
        return data.get('approvedBy', '') == ''
          && data.get('approvedByUid', '') == ''
          && data.get('approvedByEmail', '') == ''
          && data.get('approvedDate', '') == ''
          && data.get('approvedAt', '') == '';
      }

      function approvedLock() {
        return resource.data.get('approvalStatus', '下書き') != '承認済み'
          || (
            canApprove()
            && request.resource.data.approvalStatus == '差戻し'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'approvalStatus',
                'returnedBy',
                'returnedByUid',
                'returnedAt'
              ])
            && request.resource.data.get('returnedByUid', '')
              == request.auth.uid
          );
      }

      function inspectionChangeAllowed() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();

        return !changed.hasAny([
            'inspectedBy',
            'inspectedDate',
            'inspectedByUid',
            'inspectedByEmail',
            'inspectedAt'
          ])
          || (
            canInspect()
            && (
              emptyInspection(request.resource.data)
              || request.resource.data.get('inspectedByUid', '')
                == request.auth.uid
            )
          )
          || (
            request.resource.data.approvalStatus == '点検待ち'
            && resource.data.get('approvalStatus', '下書き')
              in ['下書き', '差戻し', 'Excel取込']
            && emptyInspection(request.resource.data)
            && emptyApproval(request.resource.data)
          );
      }

      function approvalChangeAllowed() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();

        return !changed.hasAny([
            'approvedBy',
            'approvedDate',
            'approvedByUid',
            'approvedByEmail',
            'approvedAt'
          ])
          || (
            canApprove()
            && (
              emptyApproval(request.resource.data)
              || request.resource.data.get('approvedByUid', '')
                == request.auth.uid
            )
          )
          || (
            request.resource.data.approvalStatus == '点検待ち'
            && resource.data.get('approvalStatus', '下書き')
              in ['下書き', '差戻し', 'Excel取込']
            && emptyInspection(request.resource.data)
            && emptyApproval(request.resource.data)
          );
      }

      function creatorChangeAllowed() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'createdBy',
            'createdByUid',
            'createdByEmail',
            'createdAtAudit',
            'reportCreatedDate'
          ])
          || isAdmin();
      }

      function statusChangeAllowed() {
        let oldStatus = resource.data.get('approvalStatus', '下書き');
        let newStatus = request.resource.data.get('approvalStatus', '下書き');

        return oldStatus == newStatus
          || (
            newStatus == '承認済み'
            && canApprove()
            && oldStatus == '承認待ち'
            && request.resource.data.get('inspectedBy', '') != ''
            && request.resource.data.get('approvedByUid', '')
              == request.auth.uid
          )
          || (
            newStatus == '承認待ち'
            && canInspect()
            && oldStatus == '点検待ち'
            && request.resource.data.get('inspectedByUid', '')
              == request.auth.uid
          )
          || (
            newStatus == '差戻し'
            && (oldStatus == '承認済み' ? canApprove() : canInspect())
          )
          || (
            newStatus in ['下書き', '点検待ち']
            && oldStatus in ['下書き', '点検待ち', '差戻し', 'Excel取込']
          );
      }
    }

    match /equipmentPreventiveTasks/{taskId} {
      function taskPath() {
        return /databases/$(database)/documents/equipmentPreventiveTasks/$(taskId);
      }
      function eventPath(id) {
        return /databases/$(database)/documents/equipmentPreventiveTasks/$(taskId)/completions/$(id);
      }
      function completionMatches(task, entry) {
        return entry.revision == task.revision && entry.at == request.time
          && task.lastCompletedAt == entry.at && task.lastActorUid == entry.actorUid
          && task.lastActorName == entry.actorName && entry.actorUid == request.auth.uid
          && entry.actorName in [profile().get('name', ''), request.auth.token.get('email', ''), request.auth.uid]
          && entry.actorName is string && entry.actorName.size() > 0;
      }

      allow read: if activeUser();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['machine', 'title', 'firstDue', 'intervalDays', 'revision', 'createdAt', 'referenceDate',
          'replacementPartName', 'replacementPartCode', 'plannedReplacementQty'])
        && request.resource.data.machine is string
        && request.resource.data.machine.size() > 0 && request.resource.data.machine.size() <= 500
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && (!request.resource.data.keys().hasAny(['referenceDate'])
          || (request.resource.data.referenceDate is string
            && request.resource.data.referenceDate.matches('20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')))
        && request.resource.data.firstDue is string
        && request.resource.data.firstDue.matches('20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
        && request.resource.data.intervalDays is int
        && request.resource.data.intervalDays >= 1 && request.resource.data.intervalDays <= 3650
        && request.resource.data.get('replacementPartName', '') is string
        && request.resource.data.get('replacementPartName', '').size() <= 120
        && request.resource.data.get('replacementPartCode', '') is string
        && request.resource.data.get('replacementPartCode', '').size() <= 80
        && (!request.resource.data.keys().hasAny(['plannedReplacementQty'])
          || (request.resource.data.plannedReplacementQty is int
            && request.resource.data.plannedReplacementQty >= 1
            && (request.resource.data.get('replacementPartName', '') != ''
              || request.resource.data.get('replacementPartCode', '') != '')))
        && request.resource.data.revision == 0 && request.resource.data.createdAt == request.time;
      allow update: if canWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'revision', 'completionId', 'lastCompletedAt', 'lastActorUid', 'lastActorName'
        ])
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.completionId is string
        && !exists(eventPath(request.resource.data.completionId))
        && completionMatches(request.resource.data, getAfter(eventPath(request.resource.data.completionId)).data);

      match /completions/{entryId} {
        allow read: if activeUser();
        allow create: if canWrite()
          && request.resource.data.keys().hasOnly(['revision', 'at', 'actorUid', 'actorName'])
          && getAfter(taskPath()).data.completionId == entryId
          && getAfter(taskPath()).data.revision == get(taskPath()).data.revision + 1
          && completionMatches(getAfter(taskPath()).data, request.resource.data);
      }
    }
    match /{collectionName}/{documentId} {
      allow read: if activeUser()
        && collectionName in [
          'parts',
          'calendar',
          'plannedWorks',
          'dailyProductions',
          'productionLogs',
          'newEquipmentProjects'
        ];

      allow create, update: if canWrite()
        && collectionName in [
          'parts',
          'calendar',
          'plannedWorks',
          'dailyProductions',
          'productionLogs',
          'newEquipmentProjects'
        ];

      allow delete: if isAdmin()
        && collectionName in [
          'parts',
          'calendar',
          'plannedWorks',
          'dailyProductions',
          'productionLogs',
          'newEquipmentProjects'
        ];
    }
  }
}
